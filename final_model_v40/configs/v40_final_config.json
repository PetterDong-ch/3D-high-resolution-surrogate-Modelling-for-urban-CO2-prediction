{
  "version": "V40 final Camden model",
  "source_project": "standalone final_model_v40 package",
  "final_checkpoint": "checkpoints/best_model.pt",
  "model": {
    "class": "final_model.model.V40EventTextureContextUNet3D",
    "model_variant": "v40_event_texture_context",
    "input_channels": 18,
    "output_channels": 1,
    "base_channels": 32,
    "global_context_channels": 9,
    "global_feature_channels": 8,
    "min_high_gate": 0.2,
    "high_delta_scale": 1.0,
    "trainable_parameters": 5761317
  },
  "target": {
    "mode": "autoregressive_delta",
    "definition": "delta_CO2 = kc_CO2(t) - kc_CO2(t-1)",
    "reconstruction": "pred_CO2(t) = kc_CO2(t-1) + pred_delta_CO2",
    "unit": "ppm"
  },
  "local_channels": [
    "emission_values",
    "ls_forcing_right_CO2",
    "u",
    "v",
    "p",
    "theta",
    "w",
    "month_sin",
    "month_cos",
    "tod_sin",
    "tod_cos",
    "x_norm",
    "y_norm",
    "z_norm",
    "prev_kc_CO2",
    "prev_dCdx",
    "prev_dCdy",
    "prev_dCdz"
  ],
  "global_context_channels": [
    "emission_values",
    "ls_forcing_right_CO2",
    "u",
    "v",
    "w",
    "p",
    "theta",
    "fluid_mask",
    "prev_kc_CO2_global"
  ],
  "data": {
    "camden_jobs_root": "external_data/raw/JOBS",
    "cache_root": "external_data/processed/patch_cache",
    "context_sidecar_root": "external_data/processed/context_sidecar",
    "previous_co2_sidecar_root": "external_data/processed/previous_co2_sidecar",
    "normalization_root": "external_data/processed/context_sidecar",
    "metadata_root": "external_data/processed/coordinate_sidecar",
    "texture_sidecar_root": "external_data/processed/texture_sidecar",
    "patch_shape": [16, 256, 256],
    "supervised_global_z": [1, 10],
    "excluded_months": [11, 12],
    "train_pool_size": 16036,
    "validation_pool_size": 1988,
    "train_samples_per_epoch": 512,
    "validation_samples": 128
  },
  "training": {
    "epochs": 70,
    "batch_size": 1,
    "num_workers": 4,
    "learning_rate": 0.00003,
    "weight_decay": 0.0001,
    "scheduler": "ReduceLROnPlateau",
    "lr_factor": 0.5,
    "lr_patience": 7,
    "min_lr": 0.000001,
    "early_stopping_patience": 18,
    "seed": 42,
    "pretrained_init": "checkpoints/best_model.pt"
  },
  "loss": {
    "base_loss": "masked Huber",
    "huber_delta": 2.0,
    "gradient_loss_weight": 0.03,
    "correlation_loss_weight": 0.04,
    "local_correlation_loss_weight": 0.05,
    "amplitude_loss_weight": 0.05,
    "active_delta_loss_weight": 0.35,
    "low_frequency_loss_weight": 0.04,
    "low_frequency_correlation_weight": 0.02,
    "high_frequency_loss_weight": 0.04,
    "sign_loss_weight": 0.015,
    "active_aux_loss_weight": 0.02,
    "sign_aux_loss_weight": 0.02,
    "residual_weight_alpha": 0.5,
    "residual_weight_scale": 4.0,
    "residual_weight_max": 4.0,
    "target_gradient_weight_alpha": 0.35,
    "target_gradient_weight_scale": 1.0,
    "target_gradient_weight_max": 2.5
  },
  "evaluation": {
    "split": "val",
    "max_samples": 128,
    "eval_layer_min": 1,
    "eval_layer_max": 10,
    "eval_min_layer_overlap": 8,
    "inference_mode": "prepared_cache"
  }
}
